                                        "name": "toolName",
                                        "type": "hidden",
                                        "label": "Tool Name"
                                    },
                                    {
                                        "name": "arguments",
                                        "type": "hidden",
                                        "label": "Arguments"
                                    }
                                ]
                            }
                        }
                    ]
                }
            ]
