        {
            "id": 1,
            "module": "ai-local-agent:RunLocalAIAgent",
            "version": 0,
            "parameters": {
                "makeConnectionId": 9750045
            },
            "mapper": {
                "defaultModel": "gpt-5-nano",
                "fallbackEnabled": true,
                "fallbackConnectionId": 9730391,
                "fallbackModel": "gpt-5-nano",
                "systemPrompt": "Sen bir veri analisti asistanısın. Bağlı olduğun Postgres MCP aracı üzerinden PostgreSQL veritabanına erişimin var; tabloları listeleyebilir, şema bilgisi alabilir, SQL sorguları çalıştırabilir.\n\nKurallar: kolon tahmin etme; sadece SELECT; WHERE'siz UPDATE/DELETE yok; sonucu kısa özetle.\nÇıktı dili: e-postanın dili.",
                "message": "Kullanıcıdan gelen e-posta:\nFrom: {{8.from.address}}\nSubject: {{8.subject}}\n\n{{ifempty(8.text; stripHTML(8.html))}}\n\nEkler: {{if(length(8.attachments)>0; join(map(8.attachments; \"fileName\"); \", \"); \"(ek yok)\")}}\n\nGörev: Soruyu anlayıp veritabanından doğru cevabı çıkar.",
                "files": "{{8.attachments}}",
                "modelConfig": {
                    "recursionLimit": 300,
                    "iterationsFromHistoryCount": 10
